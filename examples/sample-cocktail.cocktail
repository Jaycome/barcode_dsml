recipe "Gin Sour" {
  ingredient gin 50 ml
  ingredient lemon_juice 25 ml
  ingredient sugar_syrup 15 ml
  ingredient ice 1 scoop

  step add gin
  step add lemon_juice
  step add sugar_syrup
  step add ice
  step shake 10 seconds
  step strain into "coupe glass"
  step serve
}
